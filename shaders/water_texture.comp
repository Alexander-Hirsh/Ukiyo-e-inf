//         float phi = k * dot(direction, P0.xy) - c * k * timeSeconds + phase;
//         float QA  = steepness * amplitude;
//         return vec3(
//                 direction.x * QA * cos(phi),   // Δx
//                 amplitude         * sin(phi),   // Δy
//                 direction.y * QA * cos(phi)    // Δz
