float waveHeight(vec2 pos, vec2 dir, float a, float wl, float s, float t)
{
        float frequency = 2 / wl;
        float phase = s * frequency;

        float d = dot(dir, pos);

        float height = a * ( pow(e, sin(pi * d * frequency + t * phase) - 1) - pow(e, -2) - 0.5);

        float hash = hash12(pos + d);
        return height;
}

void main()
{
        ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
        ivec2 size = imageSize(heightMapImage);
        if (pixel.x >= size.x || pixel.y >= size.y)
                return;

        vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

        float h; 
        
        float amp = 1.0;
        float frequency = 1.0;
        vec2 dir = (normalize(vec2(1, 1)));

        for(int i = 1; i < 15; i++) 
        {
                float hash = hash12(dir);
                dir = normalize(vec2(hash - 0.5, hash));

                h += waveHeight(uv, dir, amp , frequency, 0.2, timeSeconds);

                amp *= 0.82;
                frequency *= 1.18;

        }

        imageStore(heightMapImage, pixel, vec4(vec3(h), 1.0));
}